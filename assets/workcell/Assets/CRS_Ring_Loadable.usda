#usda 1.0
(
    defaultPrim = "Ring"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Ring" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    customData = {
        string massSource = "User supplied"
        double specifiedMassKg = 0.2275
    }
)
{
    float physics:mass = 0.2275
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:enableCCD = 1
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 8

    def "Visual" (
        prepend references = @CRS_Ring.usdc@
    )
    {
    }

