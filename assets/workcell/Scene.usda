    def Cube "WorkcellFloorCollider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/PhysicsMaterials/Environment> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token purpose = "guide"
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (2.2, 1.75, 0.05)
        double3 xformOp:translate = (0, -0.175, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "PhysicsMaterials"
    {
        def Material "Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string coefficientBasis = "Uncalibrated simulation starting estimate; not measured from visual shader"
            }
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.6
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "Plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string coefficientBasis = "Uncalibrated simulation starting estimate; not measured from visual shader"
            }
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "POM" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string coefficientBasis = "Uncalibrated simulation starting estimate; not measured from visual shader"
            }
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.25
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "Paper" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string coefficientBasis = "Uncalibrated simulation starting estimate; not measured from visual shader"
            }
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "Environment" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            customData = {
                string coefficientBasis = "Uncalibrated simulation starting estimate; not measured from visual shader"
            }
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.6
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }
    }

    def Xform "ContainmentWalls"
    {
        uniform token purpose = "guide"
        token visibility = "inherited"

        def Cube "West" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/PhysicsMaterials/Environment> (
                bindMaterialAs = "weakerThanDescendants"
            )
            bool physics:collisionEnabled = 1
            custom float physxCollision:contactOffset = 0.005
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.2, 4.55, 3.45)
            double3 xformOp:translate = (-1.75, 0.025000000000000133, 1.475)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "East" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/PhysicsMaterials/Environment> (
                bindMaterialAs = "weakerThanDescendants"
            )
            bool physics:collisionEnabled = 1
            custom float physxCollision:contactOffset = 0.005
            custom float physxCollision:restOffset = 0
